<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo en Android 11 o menor. La sesión (token del SIIA) no se respalda:
     al restaurar en otro teléfono el alumno vuelve a entrar con contraseña y NIP.
     La foto de perfil tampoco. -->
<full-backup-content>
    <exclude domain="sharedpref" path="appteschi_sesion.xml" />
    <exclude domain="file" path="fotos_perfil/" />
</full-backup-content>
