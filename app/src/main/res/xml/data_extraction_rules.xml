<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo en Android 12 o mayor. La sesión (token del SIIA) y la foto de
     perfil no se respaldan ni se copian a otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="appteschi_sesion.xml" />
        <exclude domain="file" path="fotos_perfil/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="appteschi_sesion.xml" />
        <exclude domain="file" path="fotos_perfil/" />
    </device-transfer>
</data-extraction-rules>
