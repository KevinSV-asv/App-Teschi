  "item": [
    {
      "name": "SIIA - Login real",
      "description": "Flujo Fase 2: valida contra el SIIA real, emite ticket, envia OTP y verifica. Corre las 3 en orden — cada una guarda automaticamente las variables que necesita la siguiente (ticket, identificador, tipo). Llena antes siia_usuario y siia_password en las variables de la coleccion, y codigo despues de revisar tu correo.",
      "item": [
        {
          "name": "1. Login SIIA (POST /api/auth/siia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "",
                  "if (pm.response.code === 200 && data.ok && data.ticket) {",
                  "    pm.collectionVariables.set(\"ticket\", data.ticket);",
                  "    pm.collectionVariables.set(\"identificador\", data.identificador);",
                  "    pm.collectionVariables.set(\"tipo\", data.tipo);",
                  "    console.log(\"[SIIA] Ticket guardado. Correo enmascarado: \" + data.correoEnmascarado);",
                  "} else if (data.cuentaPendiente) {",
                  "    console.log(\"[SIIA] Cuenta pendiente de carrera para: \" + data.nombre);",
                  "} else if (data.requiereCorreo) {",
                  "    console.log(\"[SIIA] Falta correo registrado para: \" + data.identificador);",
                  "} else {",
                  "    console.log(\"[SIIA] Login fallo: \" + (data.error || pm.response.text()));",
                  "}",
                  "",
                  "pm.test(\"Respuesta procesada\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 404, 429, 502]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{siia_usuario}}\",\n  \"password\": \"{{siia_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/siia",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "siia"
              ]
            }
          }
        },
        {
          "name": "2. Enviar codigo OTP (POST /api/otp/enviar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log(\"[OTP][ENVIAR] \" + JSON.stringify(data));",
                  "",
                  "pm.test(\"Se pidio el codigo (o el backend explico por que no)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 404, 429]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"{{tipo}}\",\n  \"matricula\": \"{{identificador}}\",\n  \"correo\": \"\",\n  \"ticket\": \"{{ticket}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/otp/enviar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "otp",
                "enviar"
              ]
            },
            "description": "El campo \"correo\" se deja vacio a proposito: para un ALUMNO con correo ya guardado el backend lo ignora y usa el que tiene en la base (CorreoOtp / CorreoInstitucional)."
          }
        },
        {
          "name": "3. Verificar codigo OTP (POST /api/otp/verificar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log(\"[OTP][VERIFICAR] \" + JSON.stringify(data));",
                  "",
                  "if (data.ok && data.token) {",
                  "    pm.collectionVariables.set(\"alumno_token\", data.token);",
                  "    console.log(\"[OTP] Token de sesion guardado en {{alumno_token}}\");",
                  "}",
                  "",
                  "pm.test(\"Se verifico (o el backend explico por que no)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 404, 429]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"{{tipo}}\",\n  \"matricula\": \"{{identificador}}\",\n  \"codigo\": \"{{codigo}}\",\n  \"ticket\": \"{{ticket}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/otp/verificar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "otp",
                "verificar"
              ]
            },
            "description": "Llena la variable de coleccion \"codigo\" con el codigo de 6 digitos que llego al correo antes de correr esto."
          }
        }
      ]
    },
    {
      "name": "SIIA - API real (directa)",
      "description": "Llama DIRECTO a la API del SIIA (https://siia.teschi.edu.mx/Teschi/api), sin pasar por el backend de AppTESCHI. Util para ver exactamente que trae el login (tipo, idCarrera, correo) y probar asistencia. El login de aqui guarda el token en siia_token para las demas requests.",
      "item": [
        {
          "name": "1. Login (SIIA real)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log(\"[SIIA-REAL][LOGIN] \" + JSON.stringify(data));",
                  "",
                  "if (pm.response.code === 200 && data.ok && data.token) {",
                  "    pm.collectionVariables.set(\"siia_token\", data.token);",
                  "    const u = data.usuario || {};",
                  "    console.log(\"[SIIA-REAL] tipo=\" + u.tipo + \" idCarrera=\" + u.idCarrera + \" carrera=\\\"\" + u.carrera + \"\\\" tipoCarrera=\\\"\" + u.tipoCarrera + \"\\\" area=\\\"\" + u.area + \"\\\" numUsuario=\" + u.numUsuario);",
                  "} else {",
                  "    console.log(\"[SIIA-REAL] Login fallo: \" + (data.mensaje || pm.response.text()));",
                  "}",
                  "",
                  "pm.test(\"El SIIA respondio\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403, 422, 429]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{siia_usuario}}\",\n  \"password\": \"{{siia_password}}\"\n}"
            },
            "url": {
              "raw": "{{siia_base_url}}/login.ashx",
              "host": [
                "{{siia_base_url}}"
              ],
              "path": [
                "login.ashx"
              ]
            },
            "description": "Valida el usuario del SIIA y devuelve un token (480 min) + los datos reales del usuario (tipo, idCarrera, correo, etc). Maximo 5 intentos por usuario+IP cada 60s."
          }
        },
        {
          "name": "2. Listar grupos del docente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log(\"[SIIA-REAL][GRUPOS] \" + JSON.stringify(data));",
                  "",
                  "pm.test(\"Respondio\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{siia_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{siia_base_url}}/asistencia/grupos.ashx?periodo={{siia_periodo}}",
              "host": [
                "{{siia_base_url}}"
              ],
              "path": [
                "asistencia",
                "grupos.ashx"
              ],
              "query": [
                {
                  "key": "periodo",
                  "value": "{{siia_periodo}}",
                  "description": "Opcional. Si se omite, usa el periodo actual."
                }
              ]
            },
            "description": "Solo para cuentas tipo docente. Requiere el token de la request 1."
          }
        },
        {
          "name": "3. Listar alumnos y asistencia de un grupo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log(\"[SIIA-REAL][ALUMNOS] \" + JSON.stringify(data));",
                  "",
                  "pm.test(\"Respondio\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{siia_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{siia_base_url}}/asistencia/alumnos.ashx?grupo={{siia_grupo}}&idMateria={{siia_idMateria}}&periodo={{siia_periodo}}",
              "host": [
                "{{siia_base_url}}"
              ],
              "path": [
                "asistencia",
                "alumnos.ashx"
              ],
              "query": [
                {
                  "key": "grupo",
                  "value": "{{siia_grupo}}",
                  "description": "Requerido, ej. 1ISC11"
                },
                {
                  "key": "idMateria",
                  "value": "{{siia_idMateria}}",
                  "description": "Requerido"
                },
                {
                  "key": "periodo",
                  "value": "{{siia_periodo}}",
                  "description": "Opcional"
                },
                {
                  "key": "fecha",
                  "value": "",
                  "description": "Opcional, formato dd/MM/yyyy",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "4. Guardar o retirar asistencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "console.log(\"[SIIA-REAL][GUARDAR] \" + JSON.stringify(data));",
                  "",
                  "pm.test(\"Respondio\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{siia_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"periodo\": \"{{siia_periodo}}\",\n  \"grupo\": \"{{siia_grupo}}\",\n  \"idMateria\": {{siia_idMateria}},\n  \"matricula\": \"\",\n  \"fecha\": \"\",\n  \"asistencia\": true\n}"
            },
            "url": {
              "raw": "{{siia_base_url}}/asistencia/guardar.ashx",
              "host": [
                "{{siia_base_url}}"
              ],
              "path": [
                "asistencia",
                "guardar.ashx"
              ]
            }
          }
        }
      ]
    },
