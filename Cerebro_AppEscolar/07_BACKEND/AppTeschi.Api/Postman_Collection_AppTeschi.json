  "item": [
    {
      "name": "SIIA - Login real (AppTESCHI)",
      "description": "Flujo real de la app: el backend valida la contrasena con el SIIA, el SIIA pide su NIP de 4 digitos (DEC-041) y con el NIP correcto el backend entrega la sesion de AppTESCHI; con esa sesion se consultan las calificaciones parciales del SIIA (DEC-042). Llena siia_usuario, siia_password y siia_nip en las variables de la coleccion y corre 1 -> 2 -> 4 en orden: cada una guarda lo que necesita la siguiente. \"3. Crear NIP\" solo si el login dice tieneNip=false (crea el NIP en el SIIA real). Las dos peticiones \"(Sin NIP)\" solo aplican si el SIIA dejara de pedir NIP.",
      "item": [
        {
          "name": "1. Login SIIA (POST /api/auth/siia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/siia",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "siia"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{siia_usuario}}\",\n  \"password\": \"{{siia_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Valida usuario y contrasena con el SIIA real. Responde requiereNip + ticketNip (10 min)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.ok && data.requiereNip) {",
                  "    pm.collectionVariables.set(\"ticketNip\", data.ticketNip);",
                  "    console.log(\"[SIIA] Contrasena correcta. tieneNip=\" + data.tieneNip + (data.tieneNip ? \" -> corre 2. Verificar NIP\" : \" -> corre 3. Crear NIP\"));",
                  "} else if (pm.response.code === 200 && data.ok && data.ticket) {",
                  "    pm.collectionVariables.set(\"ticket\", data.ticket);",
                  "    pm.collectionVariables.set(\"identificador\", data.identificador);",
                  "    pm.collectionVariables.set(\"tipo\", data.tipo);",
                  "    console.log(\"[SIIA] El SIIA no pidio NIP: usa las peticiones (Sin NIP). Correo: \" + data.correoEnmascarado);",
                  "} else if (data.cuentaPendiente) {",
                  "    console.log(\"[SIIA] Cuenta pendiente de carrera para: \" + data.nombre);",
                  "} else {",
                  "    console.log(\"[SIIA] Login fallo: \" + (data.error || pm.response.text()));",
                  "}",
                  "pm.test(\"Contrasena aceptada por el SIIA\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(data.ok).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verificar NIP (POST /api/auth/siia/nip)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/siia/nip",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "siia",
                "nip"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketNip\": \"{{ticketNip}}\",\n  \"nip\": \"{{siia_nip}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verifica el NIP con el SIIA. Correcto: token de sesion de AppTESCHI (12 h). 5 intentos por inicio de sesion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.ok && data.token) {",
                  "    pm.collectionVariables.set(\"alumno_token\", data.token);",
                  "    pm.collectionVariables.set(\"identificador\", data.identificador);",
                  "    console.log(\"[NIP] Sesion de AppTESCHI guardada en alumno_token\" + (data.sinRegistro ? \" (alumno sin registro en AppTESCHI)\" : \"\"));",
                  "} else if (data.cuentaPendiente) {",
                  "    console.log(\"[NIP] Cuenta pendiente de carrera para: \" + data.nombre);",
                  "} else {",
                  "    console.log(\"[NIP] \" + (data.error || pm.response.text()));",
                  "}",
                  "pm.test(\"NIP aceptado y sesion entregada\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(data.token).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Crear NIP - solo primera vez (POST /api/auth/siia/nip)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/siia/nip",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "siia",
                "nip"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketNip\": \"{{ticketNip}}\",\n  \"nuevoNip\": \"{{siia_nip}}\",\n  \"confirmarNip\": \"{{siia_nip}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Solo si 1. Login respondio tieneNip=false. Registra siia_nip como NIP en el SIIA real (409 si ya tenia uno)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.ok && data.token) {",
                  "    pm.collectionVariables.set(\"alumno_token\", data.token);",
                  "    pm.collectionVariables.set(\"identificador\", data.identificador);",
                  "    console.log(\"[NIP] NIP creado en el SIIA; sesion guardada en alumno_token\");",
                  "} else {",
                  "    console.log(\"[NIP] \" + (data.error || pm.response.text()));",
                  "}",
                  "pm.test(\"El backend respondio\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 409, 422, 429, 502]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Mis calificaciones parciales (GET /api/mi-calificaciones-siia)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alumno_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mi-calificaciones-siia",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mi-calificaciones-siia"
              ],
              "query": [
                {
                  "key": "periodo",
                  "value": "{{siia_periodo}}",
                  "description": "Opcional (ej. 2026-1). Desactivado = periodo actual.",
                  "disabled": true
                }
              ]
            },
            "description": "Calificaciones parciales del SIIA a traves del backend (el token del SIIA se queda en el servidor). Requiere 2. Verificar NIP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.ok && data.bloqueado) {",
                  "    console.log(\"[CALIF] Bloqueado en el SIIA: \" + data.mensaje + \" | pendientes: \" + (data.pendientes || []).join(\", \"));",
                  "} else if (data.ok) {",
                  "    console.log(\"[CALIF] periodo=\" + data.periodo + \" materias=\" + (data.calificaciones || []).length + \" periodos=\" + (data.periodosDisponibles || []).join(\", \") + (data.aviso ? \" aviso: \" + data.aviso : \"\"));",
                  "} else {",
                  "    console.log(\"[CALIF] \" + (data.error || pm.response.text()));",
                  "}",
                  "pm.test(\"Calificaciones entregadas\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(data.ok).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
