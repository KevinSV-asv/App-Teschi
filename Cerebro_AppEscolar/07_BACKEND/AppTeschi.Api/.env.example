PORT=4000
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=AppTeschiDB
DB_USERNAME=sa
DB_PASSWORD=tu_password
DB_ENCRYPT=false

# Envío de OTP por correo (login de alumno y de administrador)
EMAIL_SENDER=tu_cuenta@gmail.com
EMAIL_APP_PASSWORD=contraseña_de_aplicacion
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Correo por Microsoft Graph (cuenta institucional de Microsoft 365). Si las CUATRO están
# definidas, el OTP sale por ahí y EMAIL_* queda como respaldo sin usar; si falta alguna, se usa SMTP.
# El tenant de teschi.edu.mx es público: dcec6cc1-cc36-4bdf-a82c-eaddb2de00ea
# MS_CLIENT_ID es el "Application (client) ID" de la app registrada (NO el "Secret ID").
# MS_CLIENT_SECRET es el VALOR del secreto (solo se ve al crearlo). Nunca en el repositorio ni en la app.
# La app necesita el permiso Microsoft Graph > Application > Mail.Send con consentimiento de administrador.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER=appteschi@teschi.edu.mx

# Firma de los tickets de login y de los tokens de sesión (administrador y alumno).
# Mínimo 32 caracteres (si no, la API no arranca). Genera el tuyo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_el_tuyo_no_uses_este_valor

# Vigencia del token de sesión del alumno (por defecto 12h; el del administrador es fijo, 12h)
#JWT_ALUMNO_EXPIRA_EN=12h

# SOLO cuando la API está detrás de un túnel de Cloudflare: escuchar únicamente en
# 127.0.0.1 y leer la IP real del cliente del header CF-Connecting-IP (límite de
# intentos). Activar las dos juntas: con la API alcanzable directo, ese header se falsifica.
#HOST=127.0.0.1
#TRUST_CLOUDFLARE=true
